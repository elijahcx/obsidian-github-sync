{
  "name": "obsidian-multisync",
  "version": "1.0.0",
  "description": "Sync Obsidian vaults across devices via GitHub",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json && node tests/setup-test-dist.cjs",
    "test": "npm run build:test && node --test \".test-dist/tests/**/*.test.js\"",
    "test:watch": "npm run build:test && node --test --watch \".test-dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
